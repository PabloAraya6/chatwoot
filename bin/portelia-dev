#!/bin/sh
# Levanta el taller (PORTELIA.md): Caddy en http://localhost:3020 delante de Rails, con Vite en hot
# reload y /mi/* proxeado a la API propia corriendo en la Mac (puerto 3002), sobre el Postgres y el
# Redis del laboratorio. TALLER=N levanta otro taller aparte (puertos 3020+N, 3036+N y API 3002+N),
# para trabajar varios worktrees a la vez. Sin argumentos hace `up`; con argumentos los pasa a
# docker compose (down, logs -f, exec rails-taller ...).
set -eu
cd "$(dirname "$0")/.."
export LABORATORIO="${LABORATORIO:-$HOME/Projects/chatwoot}"
REDIS_PASSWORD="$(grep '^REDIS_PASSWORD=' "$LABORATORIO/.env" | cut -d= -f2-)"
export REDIS_PASSWORD
GIT_SHA="$(git rev-parse HEAD)"
export GIT_SHA
export TALLER="${TALLER:-0}"
export PUERTO_RAILS=$((3020 + TALLER))
export PUERTO_VITE=$((3036 + TALLER))
export PUERTO_API="${PUERTO_API:-$((3002 + TALLER))}"
# Una base de Redis por taller: las colas de Sidekiq viven ahí, y si dos talleres compartieran
# la misma, el Sidekiq de uno correría los jobs del otro con su código. El laboratorio usa la 0.
export REDIS_DB=$((1 + TALLER))
compose() { docker compose -p "taller-$TALLER" -f docker-compose.portelia.yaml "$@"; }
# El volumen node_modules se llena desde la imagen la primera vez: un solo contenedor primero,
# porque tres a la vez pisándose los symlinks de pnpm rompen el arranque.
case "${1:-up}" in up) compose up -d vite-taller ;; esac
compose "${@:-up}"
